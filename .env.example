# ---- Sanity ----
# NEXT_PUBLIC_SANITY_PROJECT_ID=
# NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# SANITY_API_TOKEN=              # Editor-permission token, only needed for `npm run seed`
# SANITY_REVALIDATE_SECRET=      # shared secret for the Sanity publish webhook -> /api/revalidate

# ---- Resend (booking form email) ----
# RESEND_API_KEY=                # from resend.com — powers /api/booking

# ---- Site ----
# NEXT_PUBLIC_SITE_URL=https://royalopticals.com
